#!/usr/bin/env python3
"""Publish short-lived work progress to the Omarchy top bar.

Each job is an atomically written JSON record in
$XDG_STATE_HOME/agent-progress.  The command deliberately has no dependency
on a particular agent, terminal, or job runner: anything that can execute a
command can report progress.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import sys
import time
from datetime import UTC, datetime
from pathlib import Path


JOB_ID = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")
ACTIVE_STATES = {"running", "paused", "blocked"}


def state_dir() -> Path:
    root = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    path = root / "agent-progress"
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    return path


def timestamp() -> str:
    return datetime.now(UTC).isoformat(timespec="seconds").replace("+00:00", "Z")


def job_path(job_id: str) -> Path:
    if not JOB_ID.fullmatch(job_id):
        raise ValueError("job ID must use lowercase letters, digits, '.', '_' or '-' (up to 64 characters)")
    return state_dir() / f"{job_id}.json"


def read_job(job_id: str) -> dict:
    path = job_path(job_id)
    try:
        with path.open(encoding="utf-8") as handle:
            record = json.load(handle)
    except FileNotFoundError:
        raise ValueError(f"no progress job named '{job_id}'") from None
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"cannot read '{job_id}': {error}") from None
    if not isinstance(record, dict):
        raise ValueError(f"cannot read '{job_id}': record is not an object")
    return record


def write_job(record: dict) -> None:
    path = job_path(str(record["id"]))
    # A per-process name in the same directory, created exclusively; cheaper
    # than importing tempfile, which costs ~12 ms of startup.
    temporary = path.with_name(f".{record['id']}.{os.getpid()}.tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(record, handle, separators=(",", ":"), sort_keys=True)
            handle.write("\n")
        # No fsync: records are disposable status, and the rename alone keeps
        # readers from seeing a half-written file. Syncing cost ~85 ms a write.
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def validate_numbers(record: dict) -> None:
    for key in ("current", "total"):
        value = record.get(key)
        if value is not None and (not isinstance(value, int) or isinstance(value, bool) or value < 0):
            raise ValueError(f"{key} must be a non-negative whole number")
    if record.get("total") is not None and record.get("current", 0) > record["total"]:
        raise ValueError("current cannot exceed total")


# Display names for agents that announce themselves, by name prefix.
AGENT_NAMES = {"claude": "Claude", "codex": "Codex", "opencode": "opencode", "gemini": "Gemini"}


def agent_name(job_id: str, explicit: str | None = None) -> str | None:
    """Who is reporting: --agent, then the environment, then the ID prefix."""
    if explicit:
        return explicit
    # AI_AGENT is a cross-tool convention, e.g. "claude-code_2-1-288_agent".
    hint = os.environ.get("AI_AGENT", "")
    if not hint:
        if os.environ.get("CLAUDECODE"):
            hint = "claude"
        elif any(key.startswith("CODEX_") for key in os.environ):
            hint = "codex"
        elif any(key.startswith("OPENCODE") for key in os.environ):
            hint = "opencode"
    for prefix, name in AGENT_NAMES.items():
        if hint.lower().startswith(prefix) or (not hint and job_id.startswith(prefix + "-")):
            return name
    return hint.split("_")[0] or None


def update_record(record: dict, args: argparse.Namespace) -> dict:
    for field in ("title", "detail", "unit", "current", "total", "state", "agent"):
        value = getattr(args, field, None)
        if value is not None:
            record[field] = value
    if record.get("state") not in {"running", "paused", "blocked", "completed", "failed"}:
        raise ValueError("state must be running, paused, blocked, completed, or failed")
    validate_numbers(record)
    record["updatedAt"] = timestamp()
    return record


def start(args: argparse.Namespace) -> None:
    now = timestamp()
    record = {
        "version": 1,
        "id": args.id,
        "title": args.title or args.id.replace("-", " ").replace("_", " ").title(),
        "state": "running",
        "current": args.current if args.current is not None else 0,
        "total": args.total,
        "unit": args.unit or "items",
        "detail": args.detail or "",
        "startedAt": now,
        "updatedAt": now,
    }
    agent = agent_name(args.id, args.agent)
    if agent:
        record["agent"] = agent
    validate_numbers(record)
    write_job(record)


def update(args: argparse.Namespace) -> None:
    write_job(update_record(read_job(args.id), args))


def finish(args: argparse.Namespace) -> None:
    record = read_job(args.id)
    record["state"] = "completed"
    if record.get("total") is not None:
        record["current"] = record["total"]
    if args.detail is not None:
        record["detail"] = args.detail
    record["updatedAt"] = timestamp()
    write_job(record)


def fail(args: argparse.Namespace) -> None:
    record = read_job(args.id)
    record["state"] = "failed"
    if args.detail is not None:
        record["detail"] = args.detail
    record["updatedAt"] = timestamp()
    write_job(record)


def pipe(args: argparse.Namespace) -> None:
    """Pass stdin to stdout unchanged, counting what flows through.

    One long-lived process replaces an `update` per step: it counts bytes
    (--bytes) or lines, and publishes at most four records a second. The bar
    turns each jump into the right amount of motion, so nothing is lost by
    coalescing.
    """
    now = timestamp()
    record = {
        "version": 1,
        "id": args.id,
        "title": args.title or args.id.replace("-", " ").replace("_", " ").title(),
        "state": "running",
        "current": 0,
        "total": args.total,
        "unit": args.unit or ("bytes" if args.bytes else "items"),
        "detail": args.detail or "",
        "startedAt": now,
        "updatedAt": now,
    }
    agent = agent_name(args.id, args.agent)
    if agent:
        record["agent"] = agent
    validate_numbers(record)
    write_job(record)

    def interrupted(signum, frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, interrupted)
    source, sink = sys.stdin.buffer, sys.stdout.buffer
    count = 0
    published = time.monotonic()
    # Four records a second. Each costs the bar a file read and a rebuild,
    # and the bar glides between them at 30 Hz, so publishing faster looks
    # the same and costs both sides CPU (30 a second roughly tripled it; a
    # write per chunk took about half a core).
    interval = 0.25

    def publish(force: bool = False) -> None:
        nonlocal published
        moment = time.monotonic()
        if force or moment - published >= interval:
            record["current"] = count if args.total is None else min(count, args.total)
            record["updatedAt"] = timestamp()
            write_job(dict(record))
            published = moment

    def end(state: str, detail: str | None) -> None:
        record["state"] = state
        if detail is not None:
            record["detail"] = detail
        publish(force=True)

    try:
        if args.bytes:
            while chunk := source.read1(1 << 20):
                sink.write(chunk)
                count += len(chunk)
                publish()
        else:
            for line in source:
                sink.write(line)
                count += 1
                publish()
        sink.flush()
    except BrokenPipeError:
        # Point stdout at /dev/null so the interpreter's exit flush is quiet.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        end("failed", "Output closed early")
        raise SystemExit(1)
    except KeyboardInterrupt:
        end("failed", "Interrupted")
        raise SystemExit(130)

    if args.total is not None and count < args.total:
        end("failed", f"Ended early: {count} of {args.total} {record['unit']}")
        raise SystemExit(1)
    end("completed", args.detail)


def remove(args: argparse.Namespace) -> None:
    try:
        job_path(args.id).unlink()
    except FileNotFoundError:
        raise ValueError(f"no progress job named '{args.id}'") from None


def list_jobs(args: argparse.Namespace) -> None:
    records = []
    for path in state_dir().glob("*.json"):
        try:
            with path.open(encoding="utf-8") as handle:
                record = json.load(handle)
            if isinstance(record, dict) and record.get("state") in ACTIVE_STATES:
                records.append(record)
        except (OSError, json.JSONDecodeError):
            continue
    records.sort(key=lambda record: (str(record.get("startedAt", "")), str(record.get("id", ""))))
    if args.json:
        print(json.dumps(records, separators=(",", ":"), sort_keys=True))
        return
    for record in records:
        current = record.get("current", 0)
        total = record.get("total")
        progress = f"{current}/{total}" if total is not None else str(current)
        print(f"{record.get('id')}\t{record.get('state')}\t{progress}\t{record.get('title')}")


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description="Publish work progress to the Omarchy top bar.")
    commands = result.add_subparsers(dest="command", required=True)

    def job_options(command: argparse.ArgumentParser, include_title: bool = False) -> None:
        if include_title:
            command.add_argument("--title", help="short bar/popup title")
            command.add_argument("--agent", help="who is reporting (default: detected, e.g. Claude or Codex)")
        command.add_argument("--current", type=int, help="completed items")
        command.add_argument("--total", type=int, help="total items")
        command.add_argument("--unit", help="item unit, such as photos or files")
        command.add_argument("--detail", help="short status detail")

    command = commands.add_parser("start", help="start or replace a job")
    command.add_argument("id")
    job_options(command, include_title=True)
    command.set_defaults(handler=start)

    command = commands.add_parser("update", help="update a job")
    command.add_argument("id")
    job_options(command, include_title=True)
    command.add_argument("--state", choices=["running", "paused", "blocked", "completed", "failed"])
    command.set_defaults(handler=update)

    command = commands.add_parser("finish", help="mark a job complete and hide it")
    command.add_argument("id")
    command.add_argument("--detail")
    command.set_defaults(handler=finish)

    command = commands.add_parser("fail", help="mark a job failed and hide it")
    command.add_argument("id")
    command.add_argument("--detail")
    command.set_defaults(handler=fail)

    command = commands.add_parser("pipe", help="report data flowing from stdin to stdout")
    command.add_argument("id")
    command.add_argument("--title", help="short bar/popup title")
    command.add_argument("--agent", help="who is reporting (default: detected, e.g. Claude or Codex)")
    command.add_argument("--total", type=int, help="expected bytes or lines")
    command.add_argument("--unit", help="unit name (default: bytes or items)")
    command.add_argument("--detail", help="short status detail")
    command.add_argument("--bytes", action="store_true", help="count bytes instead of lines")
    command.set_defaults(handler=pipe)

    command = commands.add_parser("remove", help="remove a job record")
    command.add_argument("id")
    command.set_defaults(handler=remove)

    command = commands.add_parser("list", help="list active jobs")
    command.add_argument("--json", action="store_true", help="emit active records as JSON")
    command.set_defaults(handler=list_jobs)
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        args.handler(args)
    except ValueError as error:
        print(f"agent-progress: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
